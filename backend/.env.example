# Which AI provider runs new interviews: "anthropic" (Claude) or "groq" (cheap, for early testing).
LLM_PROVIDER=anthropic

# Groq key: https://console.groq.com/keys
GROQ_API_KEY=

# Anthropic key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional model overrides for the selected provider. Defaults:
#   groq:      openai/gpt-oss-120b for both
#   anthropic: claude-sonnet-5-5 (interview), claude-opus-5-5 (report)
# INTERVIEWER_MODEL=
# REPORT_MODEL=

# Shorter interviews are handy while testing (and easier on Groq's free-tier limits).
# INTERVIEW_MINUTES=45

# Alex's voice (Kokoro, runs on this machine; the model downloads on first start).
# TTS_VOICE=af_heart
# TTS_SPEED=1.0
# TTS_ENABLED=true
